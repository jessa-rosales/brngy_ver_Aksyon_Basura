    return fetch(`${BASE_URL}/bins`, {
      method: "POST",
      headers: getHeaders(),
      body: JSON.stringify(binData)
    });
  },

  relocateBin: async (binId, coords) => {
    return fetch(`${BASE_URL}/bins/${binId}/relocate`, {
      method: "PUT",
