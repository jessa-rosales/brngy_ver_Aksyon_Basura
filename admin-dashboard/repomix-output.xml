  const { user } = useUser(); 
  const [searchTerm, setSearchTerm] = useState('');
  const [zones, setZones] = useState([]);
  const [allBins, setAllBins] = useState([]);
  
  const [notify, setNotify] = useState({ show: false, msg: '', type: 'success' });
