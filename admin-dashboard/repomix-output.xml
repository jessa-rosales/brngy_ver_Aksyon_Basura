import React, { useState, useEffect, useRef, useMemo } from 'react';
import { X, Trash2, Plus, MapPin, Eraser, Archive } from 'lucide-react';
import { MapContainer, TileLayer, Polygon, Marker, useMapEvents, LayersControl, Popup, useMap } from 'react-leaflet';
import { renderToStaticMarkup } from 'react-dom/server';
import * as turf from '@turf/turf';
import L from 'leaflet';


const getDynamicBinIcon = (color = '#2E7D32', zoom) => {
  const baseSize = 50;
  const scaleFactor = Math.pow(2, zoom - 17);
  const size = Math.max(15, Math.min(35, baseSize * scaleFactor));
  const lucideSize = Math.max(8, size * 0.5);

  return new L.DivIcon({
    html: renderToStaticMarkup(
      <div style={{ 
        backgroundColor: color, 
        padding: '2px', 
        borderRadius: '50%', 
        border: `${Math.max(1, size * 0.05)}px solid white`,
        boxShadow: '0 2px 5px rgba(0,0,0,0.3)',
        display: 'flex',
        alignItems: 'center',
        justifyContent: 'center',
        width: `${size}px`,
        height: `${size}px`
      }}>
        <Trash2 color="white" size={lucideSize} />
      </div>
    ),
    className: 'custom-bin-icon',
    iconSize: [size, size],
    iconAnchor: [size / 2, size / 2],
  });
};

const MapController = ({ target }) => {
  const map = useMap();
  useEffect(() => {
    if (target?.latitude && target?.longitude) {
      map.flyTo([Number(target.latitude), Number(target.longitude)], 18);
    }
  }, [target, map]);
  return null;
};

const ZoomHandler = ({ setZoom }) => {
  useMapEvents({
    zoomend: (e) => setZoom(e.target.getZoom()),
  });
  return null;
};

const AddBinModal = ({ isOpen, onClose, zone, onAddBin, onDeleteBin, onRelocateBin, onNotify, existingBins = [] }) => {
  const [formData, setFormData] = useState({ binName: '', address: '' });
  const [tempMarker, setTempMarker] = useState(null);
  const [isPlacing, setIsPlacing] = useState(false);
  const [selectedBinId, setSelectedBinId] = useState(null);
  const [zoomLevel, setZoomLevel] = useState(17);
  const markerRef = useRef(null);

  useEffect(() => {
    if (isOpen) handleClearSelection();
  }, [isOpen, zone]);

  if (!isOpen || !zone) return null;

  const handleClearSelection = () => {
    setTempMarker(null);
    setIsPlacing(false);
    setSelectedBinId(null);
    setFormData({ binName: '', address: '' });
  };

  const getSafeBoundaries = () => {
    if (!zone?.boundaries) return [];
    return Array.isArray(zone.boundaries[0]) ? zone.boundaries[0] : zone.boundaries;
  };

  const safeBoundaries = getSafeBoundaries();

  if (safeBoundaries.length === 0) {
    return (
      <div className="fixed inset-0 z-[4000] flex items-center justify-center bg-black/60">
        <div className="bg-white p-6 rounded-xl shadow-2xl">Error: Zone has no boundary data.</div>
      </div>
    );
  }

  const handleRelocateEnd = (bin, e) => {
    const { lat, lng } = e.target.getLatLng();
    const polyCoords = safeBoundaries.map(p => [p.lng, p.lat]);
    if (polyCoords[0][0] !== polyCoords[polyCoords.length - 1][0]) polyCoords.push(polyCoords[0]);

    if (turf.booleanPointInPolygon(turf.point([lng, lat]), turf.polygon([polyCoords]))) {
      if (window.confirm(`Relocate "${bin.bin_name}" to this new position?`)) {
        onRelocateBin(bin.bin_id, { lat, lng });
      }
    } else {
      onNotify(`Error: Position is outside of "${zone.zone_name}"`, "error");
    }
    setSelectedBinId(null);
  };

  const DraggableMarker = () => {
    const handlers = useMemo(() => ({
      dragend() {
        const marker = markerRef.current;
        if (marker != null) {
          const { lat, lng } = marker.getLatLng();
          const polyCoords = safeBoundaries.map(p => [p.lng, p.lat]);
          if (polyCoords[0][0] !== polyCoords[polyCoords.length - 1][0]) polyCoords.push(polyCoords[0]);
          if (turf.booleanPointInPolygon(turf.point([lng, lat]), turf.polygon([polyCoords]))) {
            setTempMarker({ lat, lng });
          } else {
            onNotify("Bin must be placed inside the zone boundary.", "error");
            if (tempMarker) marker.setLatLng([tempMarker.lat, tempMarker.lng]);
          }
        }
      },
    }), [tempMarker]);

    return tempMarker ? (
      <Marker 
        draggable={true} 
        eventHandlers={handlers} 
        position={[tempMarker.lat, tempMarker.lng]} 
        icon={getDynamicBinIcon('#2E7D32', zoomLevel)}
        ref={markerRef}
      >
        <Popup className="font-bold">New Bin Position</Popup>
      </Marker>
    ) : null;
  };

  const MapClickHandler = () => {
    useMapEvents({
      click(e) {
        if (!isPlacing) return;
        const { lat, lng } = e.latlng;
        const polyCoords = safeBoundaries.map(p => [p.lng, p.lat]);
        if (polyCoords[0][0] !== polyCoords[polyCoords.length - 1][0]) polyCoords.push(polyCoords[0]);
        if (turf.booleanPointInPolygon(turf.point([lng, lat]), turf.polygon([polyCoords]))) {
          setTempMarker({ lat, lng });
          setIsPlacing(false);
        } else {
          onNotify("Please click inside the highlighted green area!", "error");
        }
      },
    });
    return null;
  };

  const handleAddLocation = () => {
    if (!formData.binName || !tempMarker) return onNotify("Please provide a name and mark the map.", "error");
    onAddBin({
      bin_name: formData.binName,
      zone_id: zone.zone_id,
      latitude: tempMarker.lat,
      longitude: tempMarker.lng,
      collection_status: "Pending",
      bin_address: formData.address
    });
    handleClearSelection();
  };

  return (
    <div className="fixed inset-0 z-[4000] flex items-center justify-center bg-black/40 backdrop-blur-[1px] p-4">
      <div className="bg-white rounded-xl w-full max-w-7xl h-[90vh] flex flex-col overflow-hidden shadow-2xl relative">
        
        {/* HEADER */}
        <div className="px-8 py-5 border-b flex justify-between items-center bg-white">
          <div>
            <h2 className="text-3xl font-bold text-gray-800">Manage Bin Locations</h2>
            <p className="text-gray-400 text-sm flex items-center gap-2">
               Current Action Area: <span className="bg-green-100 text-green-700 px-2 py-0.5 rounded-md font-bold text-xs border border-green-200">{zone.zone_name}</span>
            </p>
          </div>
          <button onClick={onClose} className="text-gray-400 hover:text-gray-600 transition-colors cursor-pointer"><X size={30} /></button>
        </div>

        <div className="flex flex-1 overflow-hidden">
          
          {/* LEFT SIDEBAR: NEW BIN FORM */}
          <div className="w-80 p-6 flex flex-col gap-6 overflow-y-auto bg-[#f9fafb] border-r">
            <div className="bg-[#E8F5E9] rounded-2xl p-5 border border-green-100 space-y-4 shadow-sm">
              <h3 className="font-bold text-green-800 text-lg flex items-center gap-2"><Plus size={20} /> New Bin</h3>
              <div className="space-y-3">
                <input type="text" placeholder="Bin Name" className="w-full px-4 py-2.5 rounded-xl border-none bg-white shadow-sm focus:ring-2 focus:ring-green-500 outline-none text-sm" value={formData.binName} onChange={(e) => setFormData({...formData, binName: e.target.value})} />
                <input type="text" placeholder="Address / Description" className="w-full px-4 py-2.5 rounded-xl border-none bg-white shadow-sm focus:ring-2 focus:ring-green-500 outline-none text-sm" value={formData.address} onChange={(e) => setFormData({...formData, address: e.target.value})} />
              </div>

              <div className="pt-2 space-y-2 border-t border-green-200/50">
                <button onClick={() => { setIsPlacing(true); setSelectedBinId(null); }} className={`w-full py-2.5 rounded-xl font-bold text-sm flex items-center justify-center gap-2 transition-all shadow-sm cursor-pointer ${isPlacing ? 'bg-orange-500 text-white animate-pulse' : 'bg-white text-gray-700 border border-green-200'}`}>
                  <MapPin size={16} className={isPlacing ? "text-white" : "text-gray-400"} /> {isPlacing ? "Click inside the Zone..." : "Place Pin on Map"}
                </button>
                <button onClick={handleAddLocation} className="w-full py-2.5 bg-[#2E7D32] text-white rounded-xl font-bold text-sm flex items-center justify-center gap-2 hover:bg-[#1B5E20] shadow-sm transition-all active:scale-95 cursor-pointer">
                  <Plus size={16} /> Add Bin Location
                </button>
                <button onClick={handleClearSelection} className="w-full py-2 bg-white text-red-500 border border-red-100 rounded-xl font-bold text-xs flex items-center justify-center gap-2 hover:bg-red-50 transition-all cursor-pointer mt-1"><Eraser size={14} /> Clear Selection</button>
              </div>
            </div>
            
            <div className="mt-auto">
                <button onClick={onClose} className="w-full py-3 bg-[#ff6b6b] text-white font-extrabold rounded-2xl cursor-pointer shadow-md hover:opacity-90 active:scale-95 transition-all">Cancel</button>
            </div>
          </div>

          {/* CENTRAL MAP PANEL */}
          <div className="flex-1 flex flex-col bg-gray-50 relative">
            <MapContainer center={[Number(safeBoundaries[0].lat), Number(safeBoundaries[0].lng)]} zoom={17} className="h-full w-full">
              <ZoomHandler setZoom={setZoomLevel} />
              
              <LayersControl position="bottomleft">
                <LayersControl.BaseLayer checked name="Google Streets"><TileLayer url="https://{s}.google.com/vt/lyrs=m&x={x}&y={y}&z={z}" subdomains={['mt0', 'mt1', 'mt2', 'mt3']} attribution="&copy; Google Maps" /></LayersControl.BaseLayer>
                <LayersControl.BaseLayer name="Satellite View"><TileLayer url="https://{s}.google.com/vt/lyrs=s,h&x={x}&y={y}&z={z}" subdomains={['mt0', 'mt1', 'mt2', 'mt3']} attribution="&copy; Google Maps" /></LayersControl.BaseLayer>
              </LayersControl>

              <Polygon positions={safeBoundaries} pathOptions={{ color: '#2E7D32', fillColor: '#4CAF50', fillOpacity: 0.25, weight: 0.2 }} />
              
              {existingBins && existingBins.map(bin => (
                <Marker 
                  key={bin.bin_id} 
                  position={[Number(bin.latitude), Number(bin.longitude)]} 
                  icon={getDynamicBinIcon(selectedBinId === bin.bin_id ? '#1E88E5' : '#2E7D32', zoomLevel)}
                  draggable={selectedBinId === bin.bin_id}
                  eventHandlers={{ dragend: (e) => handleRelocateEnd(bin, e) }}
                >
                  <Popup className="font-bold">{bin.bin_name}</Popup>
                </Marker>
              ))}

              <DraggableMarker />
              <MapClickHandler />
              <MapController target={existingBins.find(b => b.bin_id === selectedBinId)} />
            </MapContainer>

            {/* FLOATING STATUS INDICATOR */}
            <div className="absolute top-4 left-1/2 -translate-x-1/2 z-[1000] pointer-events-none">
                 <div className={`px-4 py-2 rounded-full shadow-lg border flex items-center gap-2 transition-all ${isPlacing ? 'bg-orange-500 border-orange-400 text-white animate-bounce' : 'bg-white/90 text-gray-700'}`}>
                    <div className={`w-2 h-2 rounded-full ${isPlacing ? 'bg-white animate-pulse' : 'bg-green-500'}`} />
                    <span className="text-[10px] font-bold uppercase tracking-wider">
                      {isPlacing ? `Click inside ${zone.zone_name}` : selectedBinId ? "Drag blue bin to relocate" : `Viewing: ${zone.zone_name}`}
                    </span>
                 </div>
            </div>
          </div>

          {/* RIGHT SIDEBAR: EXISTING BINS LIST */}
          <div className="w-80 p-6 flex flex-col overflow-hidden bg-[#f9fafb] border-l">
            <h3 className="font-bold text-gray-800 text-lg mb-4 flex items-center gap-2">
              <Trash2 size={18} className="text-gray-400" /> Existing Bins
            </h3>
            <div className="space-y-3 overflow-y-auto pr-2 flex-1">
              {existingBins && existingBins.length > 0 ? existingBins.map((bin) => (
                <div 
                  key={bin.bin_id} 
                  onClick={() => { setSelectedBinId(bin.bin_id); setTempMarker(null); }}
                  className={`p-4 rounded-xl border transition-all flex justify-between items-center group cursor-pointer ${selectedBinId === bin.bin_id ? 'border-blue-500 bg-blue-50/50 ring-2 ring-blue-100' : 'border-green-100 hover:bg-green-50/30'}`}
                >
                  <div className="min-w-0 flex-1">
                    <p className="font-bold text-gray-700 text-sm leading-tight truncate">{bin.bin_name}</p>
                    <div className="flex items-center gap-2 mt-1">
                      <span className={`text-[9px] px-1.5 py-0.5 rounded-md font-black uppercase tracking-tighter shrink-0 ${bin.collection_status === 'Pending' ? 'bg-orange-100 text-orange-600' : 'bg-green-100 text-green-600'}`}>{bin.collection_status}</span>
                      <p className="text-[11px] text-gray-400 truncate">{bin.bin_address || 'No address'}</p>
                    </div>
                  </div>
                  {/* ✅ Updated to use Archive icon and amber styling */}
                  <button title="Archive Bin" onClick={(e) => { e.stopPropagation(); onDeleteBin(bin.bin_id); }} className="text-amber-400 hover:text-amber-600 hover:bg-amber-50 rounded-lg p-2 cursor-pointer transition-all shrink-0"><Archive size={16} /></button>
                </div>
              )) : (
                <div className="text-center py-10 text-gray-400 italic text-sm">No bins in this zone yet.</div>
              )}
            </div>
            
            <div className="mt-6">
                <button onClick={onClose} className="w-full py-3 bg-[#a3ffbc] text-[#1B5E20] font-extrabold rounded-2xl cursor-pointer shadow-md hover:opacity-90 active:scale-95 transition-all">Save Changes</button>
            </div>
          </div>

        </div>
      </div>
    </div>
  );
};

export default AddBinModal;
</file>

<file path="src/components/AddUserModal.jsx">
import React, { useState, useEffect } from 'react';
import { 
  X, Eye, EyeOff, AlertCircle, User, Mail, Phone, 
  ShieldCheck, Activity, Lock, ChevronDown, Check,
  HardHat, Truck, UserCircle, Shield 
} from 'lucide-react';

// ✅ ADDED `isProcessing` PROP
const AddUserModal = ({ isOpen, onClose, onAddUser, editData, isProcessing }) => {
  const [formData, setFormData] = useState({
    firstName: '',
    lastName: '',
    email: '',
    phone: '',
    role: '',
    password: '',
    status: 'Active'
  });

  const [showPassword, setShowPassword] = useState(false);
  const [validationError, setValidationError] = useState('');
  const [activeDropdown, setActiveDropdown] = useState(null);

  // Close dropdown when clicking outside
  useEffect(() => {
    const handleClickOutside = () => setActiveDropdown(null);
    if (activeDropdown) window.addEventListener('click', handleClickOutside);
    return () => window.removeEventListener('click', handleClickOutside);
  }, [activeDropdown]);

  useEffect(() => {
    setValidationError('');
    if (editData && isOpen) {
      setFormData({
        firstName: editData.first_name || '',
        lastName: editData.last_name || '',
        email: editData.email || '',
        phone: editData.contact_number || '',
        role: editData.role || '',
        status: editData.status || 'Active',
        password: '' 
      });
    } else if (isOpen) {
      setFormData({
        firstName: '',
        lastName: '',
        email: '',
        phone: '',
        role: '',
        password: '',
        status: 'Active'
      });
    }
  }, [editData, isOpen]);

  if (!isOpen) return null;

  const handleChange = (e) => {
    setValidationError('');
    setFormData({ ...formData, [e.target.name]: e.target.value });
  };

  const handleSubmit = (e) => {
    e.preventDefault();
    const phoneRegex = /^09\d{9}$/;
    if (!phoneRegex.test(formData.phone)) {
      setValidationError("Invalid number. Must start with 09 and be exactly 11 digits.");
      return;
    }
    onAddUser(formData);
  };

  const roles = [
    { id: 'Admin', label: 'System Administrator', icon: Shield, color: 'text-purple-600', bg: 'bg-purple-50' },
    { id: 'Collector', label: 'Waste Collector', icon: HardHat, color: 'text-green-600', bg: 'bg-green-50' },
    { id: 'Driver', label: 'Vehicle Driver', icon: Truck, color: 'text-blue-600', bg: 'bg-blue-50' },
    { id: 'Citizen', label: 'Registered Citizen', icon: UserCircle, color: 'text-teal-600', bg: 'bg-teal-50' },
  ];

  const statuses = [
    { id: 'Active', label: 'Active / Enabled', dot: 'bg-green-500' },
    { id: 'Inactive', label: 'Inactive / Suspended', dot: 'bg-red-500' },
  ];

  const dropdownLabelStyle = "block text-[10px] font-black text-slate-500 uppercase tracking-tighter mb-1.5 ml-1";
  
  // ✅ Base style updated to handle disabled state styling
  const dropdownBaseStyle = `w-full pl-11 pr-10 py-3 bg-slate-50 border border-slate-200 rounded-2xl flex items-center justify-between transition-all ${
    isProcessing 
      ? 'opacity-60 cursor-not-allowed' 
      : 'cursor-pointer hover:border-emerald-400 focus-within:ring-4 focus-within:ring-emerald-50'
  }`;

  return (
    <div className="fixed inset-0 z-[9999] flex items-center justify-center p-4">
      {/* ✅ Prevent closing modal by clicking backdrop if processing */}
      <div 
        className="absolute inset-0 bg-slate-900/60 backdrop-blur-[1px] animate-in fade-in duration-300" 
        onClick={() => !isProcessing && onClose()} 
      />
      
      <div className="bg-white rounded-4xl shadow-2xl w-full max-w-xl relative overflow-hidden transform animate-in zoom-in-95 duration-200 border border-slate-100">
        
        <div className="bg-slate-50 px-8 py-6 border-b border-slate-100 flex justify-between items-center">
          <div>
            <h2 className="text-2xl font-black text-slate-800 tracking-tight">
              {editData ? 'Modify Account' : 'Create Account'}
            </h2>
            <p className="text-xs font-bold text-slate-400 uppercase tracking-widest mt-1">User Management System</p>
          </div>
          <button 
            onClick={() => !isProcessing && onClose()} 
            disabled={isProcessing}
            className={`p-2 bg-white rounded-xl transition-all border border-slate-100 ${
              isProcessing ? 'opacity-50 cursor-not-allowed text-slate-300' : 'text-slate-400 hover:text-slate-600 hover:shadow-md'
            }`}
          >
            <X size={20} />
          </button>
        </div>

        {validationError && (
          <div className="mx-8 mt-6 p-4 bg-red-50 border border-red-100 text-red-600 rounded-2xl flex items-center gap-3 text-sm font-bold animate-in slide-in-from-top-2">
            <AlertCircle size={18} className="shrink-0" />
            {validationError}
          </div>
        )}

        <form onSubmit={handleSubmit} className="p-8 space-y-6">
          
          <div className="space-y-4">
            <h4 className="text-[10px] font-black text-slate-400 uppercase tracking-[0.2em] flex items-center gap-2"><User size={12} /> Personal Details</h4>
            <div className="grid grid-cols-1 md:grid-cols-2 gap-4">
              <FormInput label="First Name" name="firstName" value={formData.firstName} onChange={handleChange} placeholder="John" disabled={isProcessing} />
              <FormInput label="Last Name" name="lastName" value={formData.lastName} onChange={handleChange} placeholder="Doe" disabled={isProcessing} />
            </div>
            <div className="grid grid-cols-1 md:grid-cols-2 gap-4">
              <FormInput icon={<Mail size={16}/>} label="Email Address" name="email" type="email" value={formData.email} onChange={handleChange} placeholder="john@example.com" disabled={isProcessing} />
              <FormInput icon={<Phone size={16}/>} label="Phone Number" name="phone" value={formData.phone} onChange={handleChange} placeholder="09123456789" disabled={isProcessing} />
            </div>
          </div>

          <div className="space-y-4 pt-2">
            <h4 className="text-[10px] font-black text-slate-400 uppercase tracking-[0.2em] flex items-center gap-2"><Lock size={12} /> Security & Access</h4>

            <div className="grid grid-cols-1 md:grid-cols-2 gap-4">
              
              {/* PROFESSIONAL ROLE DROPDOWN */}
              <div className="relative">
                <label className={dropdownLabelStyle}>Access Level</label>
                <div 
                  onClick={(e) => { 
                    if (isProcessing) return; // Prevent interaction
                    e.stopPropagation(); 
                    setActiveDropdown(activeDropdown === 'role' ? null : 'role'); 
                  }}
                  className={`${dropdownBaseStyle} ${activeDropdown === 'role' ? 'ring-4 ring-emerald-50 border-emerald-500' : ''}`}
                >
                  <div className="flex items-center gap-3">
                    <ShieldCheck className="absolute left-4 text-slate-400" size={18} />
                    <span className="text-sm font-bold text-slate-700">
                      {formData.role || "Select Role"}
                    </span>
                  </div>
                  <ChevronDown size={16} className={`text-slate-400 transition-transform duration-300 ${activeDropdown === 'role' ? 'rotate-180' : ''}`} />
                </div>
                {activeDropdown === 'role' && !isProcessing && (
                  <div className="absolute top-[110%] left-0 w-full bg-white rounded-2xl shadow-2xl border border-slate-100 z-50 py-2 animate-in fade-in slide-in-from-top-2">
                    {roles.map((r) => (
                      <div 
                        key={r.id} 
                        onClick={() => setFormData({...formData, role: r.id})}
                        className="flex items-center justify-between px-4 py-3 hover:bg-slate-50 cursor-pointer group"
                      >
                        <div className="flex items-center gap-3">
                          <div className={`p-1.5 rounded-lg ${r.bg}`}><r.icon size={16} className={r.color} /></div>
                          <span className={`text-sm font-semibold ${formData.role === r.id ? 'text-emerald-600' : 'text-slate-600'}`}>{r.label}</span>
                        </div>
                        {formData.role === r.id && <Check size={16} className="text-emerald-600" />}
                      </div>
                    ))}
                  </div>
                )}
              </div>

              {/* PROFESSIONAL STATUS DROPDOWN */}
              <div className="relative">
                <label className={dropdownLabelStyle}>Account Status</label>
                <div 
                  onClick={(e) => { 
                    if (isProcessing) return; // Prevent interaction
                    e.stopPropagation(); 
                    setActiveDropdown(activeDropdown === 'status' ? null : 'status'); 
                  }}
                  className={`${dropdownBaseStyle} ${activeDropdown === 'status' ? 'ring-4 ring-emerald-50 border-emerald-500' : ''}`}
                >
                  <div className="flex items-center gap-3">
                    <Activity className="absolute left-4 text-slate-400" size={18} />
                    <div className="flex items-center gap-2 ml-1">
                      <div className={`w-2 h-2 rounded-full ${formData.status === 'Active' ? 'bg-green-500' : 'bg-red-500'}`} />
                      <span className="text-sm font-bold text-slate-700">{formData.status}</span>
                    </div>
                  </div>
                  <ChevronDown size={16} className={`text-slate-400 transition-transform duration-300 ${activeDropdown === 'status' ? 'rotate-180' : ''}`} />
                </div>
                {activeDropdown === 'status' && !isProcessing && (
                  <div className="absolute top-[110%] left-0 w-full bg-white rounded-2xl shadow-2xl border border-slate-100 z-50 py-2 animate-in fade-in slide-in-from-top-2">
                    {statuses.map((s) => (
                      <div 
                        key={s.id} 
                        onClick={() => setFormData({...formData, status: s.id})}
                        className="flex items-center justify-between px-4 py-3 hover:bg-slate-50 cursor-pointer group"
                      >
                        <div className="flex items-center gap-3">
                          <div className={`w-2.5 h-2.5 rounded-full ${s.dot}`} />
                          <span className={`text-sm font-semibold ${formData.status === s.id ? 'text-emerald-600' : 'text-slate-600'}`}>{s.label}</span>
                        </div>
                        {formData.status === s.id && <Check size={16} className="text-emerald-600" />}
                      </div>
                    ))}
                  </div>
                )}
              </div>

            </div>

            <div className="relative">
              <label className="block text-[10px] font-black text-slate-500 uppercase tracking-tighter mb-1.5 ml-1">
                {editData ? 'New Password (Leave blank to keep current)' : 'Account Password'}
              </label>
              <div className="relative">
                <Lock className="absolute left-4 top-1/2 -translate-y-1/2 text-slate-400" size={18} />
                <input 
                  type={showPassword ? "text" : "password"} 
                  name="password" 
                  required={!editData} 
                  placeholder={editData ? "••••••••" : "Create a secure password"} 
                  disabled={isProcessing} // ✅ Disable input
                  className={`w-full pl-11 pr-12 py-3 bg-slate-50 border border-slate-200 rounded-2xl outline-none transition-all font-bold text-slate-700 text-sm placeholder:text-slate-300 ${
                    isProcessing ? 'opacity-60 cursor-not-allowed' : 'focus:ring-4 focus:ring-emerald-50 focus:border-emerald-500'
                  }`}
                  value={formData.password} 
                  onChange={handleChange} 
                />
                <button 
                  type="button" 
                  disabled={isProcessing}
                  onClick={() => setShowPassword(!showPassword)} 
                  className={`absolute right-4 top-1/2 -translate-y-1/2 transition-colors ${
                    isProcessing ? 'text-slate-300 cursor-not-allowed' : 'text-slate-400 hover:text-slate-600'
                  }`}
                >
                  {showPassword ? <EyeOff size={18} /> : <Eye size={18} />}
                </button>
              </div>
            </div>
          </div>

          <div className="flex gap-4 pt-6 border-t border-slate-50">
            <button 
              type="button" 
              onClick={() => !isProcessing && onClose()} 
              disabled={isProcessing}
              className={`flex-1 py-4 font-black uppercase text-[10px] tracking-[0.2em] rounded-2xl transition-all ${
                isProcessing ? 'bg-slate-50 text-slate-300 cursor-not-allowed' : 'bg-slate-100 hover:bg-slate-200 text-slate-600 active:scale-95'
              }`}
            >
              Cancel
            </button>
            
            {/* ✅ PROCESSING STATE ON BUTTON */}
            <button 
              type="submit" 
              disabled={isProcessing}
              className={`flex-[1.5] py-4 text-white font-black uppercase text-[10px] tracking-[0.2em] rounded-2xl transition-all flex items-center justify-center gap-2 ${
                isProcessing 
                  ? 'bg-emerald-400 cursor-not-allowed shadow-none' 
                  : 'bg-emerald-600 hover:bg-emerald-700 active:scale-95 shadow-lg shadow-emerald-200'
              }`}
            >
              {isProcessing ? (
                <>
                  <svg className="animate-spin h-4 w-4 text-white" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
                    <circle className="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" strokeWidth="4"></circle>
                    <path className="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
                  </svg>
                  Processing...
                </>
              ) : (
                editData ? 'Update' : 'Create User'
              )}
            </button>
          </div>
        </form>
      </div>
    </div>
  );
};

// ✅ FormInput now takes disabled prop
const FormInput = ({ label, icon, disabled, ...props }) => (
  <div className="w-full">
    <label className="block text-[10px] font-black text-slate-500 uppercase tracking-tighter mb-1.5 ml-1">{label}</label>
    <div className="relative">
      {icon && <div className="absolute left-4 top-1/2 -translate-y-1/2 text-slate-400">{icon}</div>}
      <input 
        required
        disabled={disabled}
        {...props}
        className={`w-full ${icon ? 'pl-11' : 'px-5'} py-3 bg-slate-50 border border-slate-200 rounded-2xl outline-none transition-all font-bold text-slate-700 text-sm placeholder:text-slate-300 ${
          disabled ? 'opacity-60 cursor-not-allowed' : 'focus:ring-4 focus:ring-emerald-50 focus:border-emerald-500'
        }`}
      />
    </div>
  </div>
);

export default AddUserModal;
</file>

