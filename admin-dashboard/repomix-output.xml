                          backgroundColor: isRunning ? '#10B981' : '#F97316',
                          border: '2px solid white'
                        }} />
                      </div>
                    </div>
                  </AnimatedMarker>
                );
              })}

              {/* Popup for Selected Truck */}
              {activeSelectedTruck && (
                <Popup
