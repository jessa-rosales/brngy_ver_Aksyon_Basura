import React from 'react';
import ReactDOM from 'react-dom';
import { AlertTriangle, X } from 'lucide-react';

const ConfirmDialog = ({ isOpen, onClose, onConfirm, title, message, confirmText = "Confirm", type = "danger" }) => {
  if (!isOpen) return null;

  const modalContent = (
    <div className="fixed inset-0 z-[10000] flex items-center justify-center p-4">
      {/* Backdrop */}
      <div className="absolute inset-0 bg-slate-900/60 backdrop-blur-md transition-opacity" onClick={onClose} />
      
      {/* Dialog Box */}
      <div className="bg-white w-full max-w-md rounded-[32px] shadow-2xl relative z-10 overflow-hidden animate-in zoom-in-95 duration-200 border border-white/20">
        <div className="p-8 flex flex-col items-center text-center">
          
          {/* Icon */}
          <div className={`w-16 h-16 rounded-2xl flex items-center justify-center mb-6 ${
            type === 'danger' ? 'bg-rose-50 text-rose-500' : 'bg-amber-50 text-amber-500'
          }`}>
            <AlertTriangle size={32} />
          </div>

          {/* Text */}
          <h3 className="text-2xl font-black text-slate-800 tracking-tight mb-2">{title}</h3>
          <p className="text-sm font-bold text-slate-500 leading-relaxed mb-8">
            {message}
          </p>

          {/* Buttons */}
          <div className="flex gap-3 w-full">
            <button 
              onClick={onClose}
              className="flex-1 py-4 bg-slate-100 hover:bg-slate-200 text-slate-600 rounded-2xl text-[10px] font-black uppercase tracking-widest transition-all"
            >
              Cancel
            </button>
            <button 
              onClick={() => { onConfirm(); onClose(); }}
              className={`flex-1 py-4 text-white rounded-2xl text-[10px] font-black uppercase tracking-widest transition-all shadow-lg ${
                type === 'danger' ? 'bg-rose-600 hover:bg-rose-700 shadow-rose-200' : 'bg-slate-900 hover:bg-emerald-600 shadow-slate-200'
              }`}
            >
              {confirmText}
            </button>
          </div>
        </div>
      </div>
    </div>
  );

  return ReactDOM.createPortal(modalContent, document.body);
};

export default ConfirmDialog;
</file>

<file path="src/components/CreateAnnouncementModal.jsx">
import React, { useState, useRef, useEffect, useCallback } from 'react';
import Cropper from 'react-easy-crop'; 
import { getCroppedImg } from '../utils/cropImage'; 
import { 
  X, Megaphone, Type, AlignLeft, Tag, AlertCircle, 
  Upload, ImagePlus, CheckCircle2, ChevronDown,
  Calendar, ShieldAlert, Wrench, Info, Trash2, Maximize
} from 'lucide-react';

const CreateAnnouncementModal = ({ isOpen, onClose, onCreate, editData }) => {
  const initialFormState = {
    title: '',
    content: '',
    category: 'Information',
    priority: 'Medium',
    status: 'Published',
    ann_photo: null
  };

  const [formData, setFormData] = useState(initialFormState);
  const [previewUrl, setPreviewUrl] = useState(null);
  const [activeDropdown, setActiveDropdown] = useState(null); 
  const [showConfirmDiscard, setShowConfirmDiscard] = useState(false);
  
  const [image, setImage] = useState(null); 
  const [crop, setCrop] = useState({ x: 0, y: 0 });
  const [zoom, setZoom] = useState(1);
  const [croppedAreaPixels, setCroppedAreaPixels] = useState(null);
  const [isCropping, setIsCropping] = useState(false);

  const fileInputRef = useRef(null);

  // ✅ PRE-FILL LOGIC
  useEffect(() => {
    if (editData && isOpen) {
      setFormData({
        title: editData.title || '',
        content: editData.content || '',
        category: editData.category || 'Information',
        priority: editData.priority || 'Medium',
        status: editData.status || 'Published',
        ann_photo: editData.ann_photo 
      });
      if (editData.ann_photo) {
        setPreviewUrl(`http://localhost:5000${editData.ann_photo}`);
      }
    } else if (!editData && isOpen) {
      setFormData(initialFormState);
      setPreviewUrl(null);
      setImage(null);
    }
  }, [editData, isOpen]);

  const onCropComplete = useCallback((activeArea, pixels) => {
    setCroppedAreaPixels(pixels);
  }, []);

  useEffect(() => {
    const handleClickOutside = () => setActiveDropdown(null);
    if (activeDropdown) window.addEventListener('click', handleClickOutside);
    return () => window.removeEventListener('click', handleClickOutside);
  }, [activeDropdown]);

  if (!isOpen) return null;

  const hasChanges = formData.title !== '' || formData.content !== '' || (previewUrl !== null && !editData);

  const handleFinalClose = () => {
    setFormData(initialFormState);
    setPreviewUrl(null);
    setImage(null);
    setShowConfirmDiscard(false);
    setIsCropping(false);
    onClose();
  };

  const handleDiscardClick = () => {
    if (hasChanges && !editData) setShowConfirmDiscard(true);
    else handleFinalClose();
  };

  const handleImageChange = (e) => {
    const file = e.target.files[0];
    if (file) {
      const reader = new FileReader();
      reader.readAsDataURL(file);
      reader.onload = () => {
        setImage(reader.result);
        setIsCropping(true); 
      };
    }
  };

  const handleRemoveImage = (e) => {
    e.stopPropagation(); 
    setFormData({ ...formData, ann_photo: null });
    setPreviewUrl(null);
    setImage(null);
    if (fileInputRef.current) fileInputRef.current.value = "";
  };

  const handleReCrop = (e) => {
    e.stopPropagation(); 
    setIsCropping(true);
  };

  const saveCroppedImage = async () => {
    try {
      const croppedBlob = await getCroppedImg(image, croppedAreaPixels);
      const file = new File([croppedBlob], "cropped.jpg", { type: "image/jpeg" });
      setFormData({ ...formData, ann_photo: file });
      setPreviewUrl(URL.createObjectURL(croppedBlob));
      setIsCropping(false);
    } catch (e) {
      console.error("Crop error:", e);
    }
  };

  const handleSubmit = (e) => {
    e.preventDefault();
    onCreate(formData);
    handleFinalClose();
  };

  const categories = [
    { label: 'Schedule', icon: Calendar, color: 'text-blue-500', bg: 'bg-blue-50' },
    { label: 'Emergency', icon: ShieldAlert, color: 'text-red-500', bg: 'bg-red-50' },
    { label: 'Maintenance', icon: Wrench, color: 'text-orange-500', bg: 'bg-orange-50' },
    { label: 'Information', icon: Info, color: 'text-green-500', bg: 'bg-green-50' },
  ];

  const priorities = [
    { label: 'Low', color: 'text-gray-400', dot: 'bg-gray-400' },
    { label: 'Medium', color: 'text-blue-500', dot: 'bg-blue-500' },
    { label: 'High', color: 'text-orange-500', dot: 'bg-orange-500' },
    { label: 'Urgent', color: 'text-red-600', dot: 'bg-red-600' },
  ];

  const labelStyle = "flex items-center gap-2 text-[11px] font-bold text-gray-400 mb-2 uppercase tracking-widest";
  const inputBaseStyle = "w-full px-5 py-3.5 rounded-2xl border border-gray-200 outline-none transition-all text-sm bg-white shadow-sm font-medium";

  return (
    <div className="fixed inset-0 z-6000 flex items-center justify-center p-4 sm:p-6">
      <div className="absolute inset-0 bg-gray-900/60 backdrop-blur-[1px] animate-in fade-in duration-300" onClick={handleDiscardClick} />
      
      <div className="bg-[#F8FAFC] w-full max-w-3xl rounded-[40px] shadow-2xl relative overflow-hidden flex flex-col max-h-[95vh] animate-in zoom-in-95 duration-200">
        
        <div className="bg-green-600 p-8 text-white py-3 px-8 flex justify-between items-center relative shadow-xl shrink-0">
          <div className="flex items-center gap-5">
            <div className="p-4 bg-white/20 rounded-3xl backdrop-blur-md border border-white/20">
              <Megaphone size={28} className="text-white" />
            </div>
            <div>
              <h3 className="font-black text-2xl leading-tight tracking-tight">
                {editData ? "Modify Announcement" : "Create Announcement"}
              </h3>
              <p className="text-green-100 text-sm font-medium opacity-90">
                {editData ? "Updating existing records" : "Post a new update for the community"}
              </p>
            </div>
          </div>
          <button type="button" onClick={handleDiscardClick} className="p-2.5 hover:bg-white/10 rounded-xl transition-all cursor-pointer">
            <X size={24} />
          </button>
        </div>

        <form onSubmit={handleSubmit} className="p-10 overflow-y-auto custom-scrollbar space-y-8">
          <div className="group shrink-0">
            <label className={labelStyle}><ImagePlus size={14} /> Cover Photo (16:9)</label>
            <div 
              onClick={() => !previewUrl && fileInputRef.current.click()}
              className={`relative w-full rounded-4xl border-2 border-dashed transition-all duration-300 flex flex-col items-center justify-center overflow-hidden shrink-0
                ${previewUrl ? 'border-green-500 bg-white ring-4 ring-green-500/5 cursor-default' : 'border-gray-200 bg-white hover:border-green-400 hover:shadow-md cursor-pointer'}`}
              style={{ aspectRatio: '16 / 9' }} 
            >
              {previewUrl ? (
                <>
                  <img src={previewUrl} alt="Preview" className="w-full h-full object-cover" />
                  <div className="absolute inset-0 bg-black/40 opacity-0 group-hover:opacity-100 transition-opacity flex items-center justify-center gap-4 backdrop-blur-[2px]">
                    <button type="button" onClick={handleReCrop} className="p-4 bg-white/20 hover:bg-white/40 rounded-2xl text-white transition-all transform hover:scale-110 flex flex-col items-center gap-1"><Maximize size={20} /><span className="text-[10px] font-bold uppercase tracking-tighter">Adjust</span></button>
                    <button type="button" onClick={handleRemoveImage} className="p-4 bg-red-500/20 hover:bg-red-500/60 rounded-2xl text-white transition-all transform hover:scale-110 flex flex-col items-center gap-1"><Trash2 size={20} /><span className="text-[10px] font-bold uppercase tracking-tighter">Remove</span></button>
                  </div>
                </>
              ) : (
                <div className="text-center p-6">
                  <div className="w-14 h-14 bg-gray-50 rounded-full flex items-center justify-center mx-auto mb-3 group-hover:scale-110 group-hover:bg-green-50 transition-all duration-300"><Upload size={22} className="text-gray-400 group-hover:text-green-600" /></div>
                  <p className="text-sm font-bold text-gray-600">Click to upload banner</p>
                  <p className="text-[10px] text-gray-400 mt-1 uppercase tracking-tighter">JPG or PNG (Max 5MB)</p>
                </div>
              )}
            </div>
            <input type="file" ref={fileInputRef} className="hidden" accept="image/*" onChange={handleImageChange} />
          </div>

          <div className="space-y-6">
            <div>
              <label className={labelStyle}><Type size={14} /> Announcement Title</label>
              <input type="text" required placeholder="Enter headline..." className={`${inputBaseStyle} focus:border-green-500 focus:ring-4 focus:ring-green-500/10`} value={formData.title} onChange={(e) => setFormData({...formData, title: e.target.value})} />
            </div>
            <div>
              <label className={labelStyle}><AlignLeft size={14} /> Description / Details</label>
              <textarea required rows="5" placeholder="Details..." className={`${inputBaseStyle} resize-none leading-relaxed focus:border-green-500 focus:ring-4 focus:ring-green-500/10`} value={formData.content} onChange={(e) => setFormData({...formData, content: e.target.value})} />
            </div>

            <div className="grid grid-cols-2 gap-6">
              <div className="relative">
                <label className={labelStyle}><Tag size={14} /> Category</label>
                <div onClick={(e) => { e.stopPropagation(); setActiveDropdown(activeDropdown === 'category' ? null : 'category'); }} className={`${inputBaseStyle} flex items-center justify-between cursor-pointer hover:border-green-400`}>
                  <span className="flex items-center gap-3">{(() => { const cat = categories.find(c => c.label === formData.category) || categories[3]; return <><cat.icon size={18} className={cat.color} /> {cat.label}</>; })()}</span>
                  <ChevronDown size={18} />
                </div>
                {activeDropdown === 'category' && (
                  <div className="absolute top-[110%] left-0 w-full bg-white rounded-2xl shadow-2xl border border-gray-100 z-50 py-2">
                    {categories.map((cat) => (
                      <div key={cat.label} onClick={() => setFormData({...formData, category: cat.label})} className="flex items-center gap-3 px-4 py-3 hover:bg-green-50 cursor-pointer text-sm font-semibold"><div className={`p-1.5 rounded-lg ${cat.bg}`}><cat.icon size={16} className={cat.color} /></div>{cat.label}</div>
                    ))}
                  </div>
                )}
              </div>

              <div className="relative">
                <label className={labelStyle}><AlertCircle size={14} /> Priority</label>
                <div onClick={(e) => { e.stopPropagation(); setActiveDropdown(activeDropdown === 'priority' ? null : 'priority'); }} className={`${inputBaseStyle} flex items-center justify-between cursor-pointer`}>
                  <span className="flex items-center gap-3"><div className={`w-2.5 h-2.5 rounded-full ${(priorities.find(p => p.label === formData.priority) || priorities[1]).dot}`} />{formData.priority}</span>
                  <ChevronDown size={18} />
                </div>
                {activeDropdown === 'priority' && (
                  <div className="absolute top-[110%] left-0 w-full bg-white rounded-2xl shadow-2xl border border-gray-100 z-50 py-2">
                    {priorities.map((p) => (
                      <div key={p.label} onClick={() => setFormData({...formData, priority: p.label})} className="flex items-center gap-3 px-4 py-3 hover:bg-green-50 cursor-pointer text-sm font-semibold"><div className={`w-3 h-3 rounded-full ${p.dot}`} />{p.label}</div>
                    ))}
                  </div>
                )}
              </div>
            </div>
          </div>

          <div className="flex gap-4 pt-6 border-t border-gray-200/60">
            <button type="button" onClick={handleDiscardClick} className="flex-1 py-4 bg-white border border-gray-200 text-gray-500 font-bold rounded-2xl transition-all active:scale-95 text-sm uppercase tracking-widest hover:bg-red-700 hover:text-white shadow-sm">Discard</button>
            <button type="submit" className="flex-[1.5] py-4 bg-green-600 text-white font-bold rounded-2xl shadow-xl shadow-green-200 hover:bg-green-700 transition-all active:scale-95 text-sm flex items-center justify-center gap-3 uppercase tracking-widest">
              <CheckCircle2 size={20} /> {editData ? "Update Changes" : "Publish Now"}
            </button>
          </div>
        </form>

        {isCropping && image && (
          <div className="absolute inset-0 z-7000 bg-gray-900 flex flex-col h-full w-full overflow-hidden">
            <div className="bg-white/10 p-6 flex justify-between items-center text-white border-b border-white/10 shrink-0">
                <div><h4 className="font-bold flex items-center gap-2"><Maximize size={18} /> Crop Your Banner</h4><p className="text-[10px] uppercase tracking-widest opacity-60">Adjust selection for 16:9 ratio</p></div>
                <button type="button" onClick={() => setIsCropping(false)} className="p-2 hover:bg-white/10 rounded-xl transition-all"><X /></button>
            </div>
            <div className="relative flex-1 bg-black"><Cropper image={image} crop={crop} zoom={zoom} aspect={16 / 9} onCropChange={setCrop} onZoomChange={setZoom} onCropComplete={onCropComplete} /></div>
            <div className="p-8 bg-white flex flex-col gap-6 shrink-0 shadow-2xl">
              <div className="flex items-center gap-6"><span className="text-[10px] font-black text-gray-400 uppercase tracking-widest">Zoom Level</span><input type="range" min={1} max={3} step={0.1} value={zoom} onChange={(e) => setZoom(parseFloat(e.target.value))} className="flex-1 accent-green-600" /></div>
              <div className="flex gap-4"><button type="button" onClick={() => setIsCropping(false)} className="flex-1 py-4 text-gray-500 font-bold border border-gray-200 rounded-2xl text-xs uppercase tracking-widest">Cancel</button><button type="button" onClick={saveCroppedImage} className="flex-2 py-4 bg-green-600 text-white font-bold rounded-2xl shadow-xl text-xs uppercase tracking-widest">Save Selection</button></div>
            </div>
          </div>
        )}

        {showConfirmDiscard && (
          <div className="absolute inset-0 z-8000 flex items-center justify-center p-6 bg-gray-900/40 backdrop-blur-[0.9px]">
            <div className="bg-white rounded-4xl p-8 max-w-sm w-full shadow-2xl text-center">
              <div className="w-16 h-16 bg-red-50 rounded-full flex items-center justify-center mx-auto mb-4"><Trash2 size={32} className="text-red-600" /></div>
              <h4 className="text-xl font-black text-gray-800 mb-2">Discard Changes?</h4>
              <p className="text-gray-500 text-sm mb-8 leading-relaxed">Your unsaved work will be lost permanently.</p>
              <div className="flex gap-3"><button onClick={() => setShowConfirmDiscard(false)} className="flex-1 py-3 bg-gray-100 hover:bg-gray-200 text-gray-600 font-bold rounded-2xl text-sm">Keep Editing</button><button onClick={handleFinalClose} className="flex-1 py-3 bg-red-600 hover:bg-red-700 text-white font-bold rounded-2xl shadow-lg text-sm">Yes, Discard</button></div>
            </div>
          </div>
        )}
      </div>
    </div>
  );
};

export default CreateAnnouncementModal;
</file>

<file path="src/components/CreateAssignmentModal.jsx">
import React, { useState, useEffect, useRef } from 'react';
import { motion, AnimatePresence } from 'framer-motion';
import { X, User, Truck, Users, MapPin, Calendar, Clock, CheckCircle2, ChevronDown, ChevronLeft, ChevronRight, ShieldCheck, Save, Edit3, } from 'lucide-react';

// ✅ CUSTOM DROPDOWN (SNAPPY & FORMATTED)
const CustomDropdown = ({
  label,
  icon: Icon,
  options,
  value,
  onChange,
  placeholder,
  isUserType,
}) => {
  const [isOpen, setIsOpen] = useState(false);
  const dropdownRef = useRef(null);

  const selectedOption = options.find(
    (opt) => String(isUserType ? opt.user_id : opt.vehicle_id || opt.zone_id) === String(value)
  );

  useEffect(() => {
    const handleClickOutside = (event) => {
      if (dropdownRef.current && !dropdownRef.current.contains(event.target)) {
        setIsOpen(false);
      }
    };
    document.addEventListener('mousedown', handleClickOutside);
    return () => document.removeEventListener('mousedown', handleClickOutside);
  }, []);

  return (
    <div className="relative" ref={dropdownRef}>
      <label className="flex items-center gap-2 text-[10px] font-black text-slate-400 mb-2 uppercase tracking-[0.2em]" >
        <Icon size={14} /> {label}
      </label>
      
      <motion.div 
        whileTap={{ scale: 0.99 }}
        onClick={() => setIsOpen(!isOpen)}
        className={`w-full px-5 py-3.5 rounded-2xl border transition-all cursor-pointer flex items-center justify-between
          ${isOpen ? 'border-emerald-500 bg-white shadow-sm' : 'border-slate-200 bg-slate-50/50 hover:border-emerald-400'}`}>
        <div 
          className="flex flex-col items-start overflow-hidden pr-2"
        >
          {selectedOption ? (
            <>
              <span 
                className="text-sm font-bold text-slate-700 truncate w-full"
              >
                {isUserType 
                  ? `${selectedOption.first_name} ${selectedOption.last_name}` 
                  : (selectedOption.vehicle_name || selectedOption.zone_name)}
              </span>
              {isUserType && (
                <span 
                  className="text-[9px] font-bold text-emerald-600 uppercase tracking-tighter"
                >
                  ID: #{selectedOption.user_id}
                </span>
              )}
            </>
          ) : (
            <span 
              className="text-sm font-bold text-slate-400"
            >
              {placeholder}
            </span>
          )}
        </div>
        <ChevronDown 
          className={`text-slate-400 transition-transform duration-300 ${isOpen ? 'rotate-180' : ''}`} 
          size={18} 
        />
      </motion.div>

      <AnimatePresence>
        {isOpen && (
          <motion.div
            initial={{ opacity: 0, y: -5 }}
            animate={{ opacity: 1, y: 5 }}
            exit={{ opacity: 0, y: -5 }}
            transition={{ duration: 0.15, ease: "easeOut" }}
            className="absolute z-[7000] w-full mt-1 bg-white border border-slate-100 rounded-[24px] shadow-xl overflow-hidden p-2"
          >
            <div 
              className="max-h-[220px] overflow-y-auto overflow-x-hidden custom-scrollbar space-y-0.5"
            >
              <div 
                onClick={() => { onChange(''); setIsOpen(false); }}
                className="px-4 py-2.5 rounded-xl text-xs font-bold text-slate-400 hover:bg-slate-50 cursor-pointer"
              >
                None / Unassigned
              </div>
              {options.map((opt) => {
                const optId = isUserType ? opt.user_id : (opt.vehicle_id || opt.zone_id);
                const isSelected = String(value) === String(optId);
                return (
                  <div 
                    key={optId} 
                    onClick={() => { onChange(optId); setIsOpen(false); }} 
                    className={`px-4 py-2.5 rounded-xl flex items-center justify-between cursor-pointer transition-colors duration-100
                      ${isSelected ? 'bg-emerald-50 text-emerald-700' : 'text-slate-600 hover:bg-slate-50 hover:text-emerald-600'}`}
                  >
                    <div 
                      className="flex flex-col min-w-0 pr-4"
                    >
                      <span 
                        className="text-sm font-bold truncate"
                      >
                        {isUserType ? `${opt.first_name} ${opt.last_name}` : (opt.vehicle_name || opt.zone_name)}
                      </span>
                      {isUserType && (
                        <span 
                          className={`text-[9px] font-bold uppercase tracking-tighter ${isSelected ? 'text-emerald-500' : 'text-slate-400'}`}
                        >
                          ID: #{opt.user_id}
                        </span>
                      )}
                    </div>
                    {isSelected && (
                      <CheckCircle2 
                        size={14} 
                        className="flex-shrink-0" 
                      />
                    )}
                  </div>
                );
              })}
            </div>
          </motion.div>
        )}
      </AnimatePresence>
    </div>
  );
};

const CreateAssignmentModal = ({ 
  isOpen, 
  onClose, 
  onCreate, 
  dataOptions, 
  editingData 
}) => {
  const [formData, setFormData] = useState({
    driver_id: '',
    collector_ids: [],
    vehicle_id: '',
    zone_id: '',
    work_days: [],
    start_time: '',
    end_time: '',
    start_date: '',
    end_date: '',
  });

  // ✅ FILTER OUT ARCHIVED DATA HERE
  const activeDrivers = (dataOptions?.drivers || []).filter(d => !d.is_archived);
  const activeCollectors = (dataOptions?.collectors || []).filter(c => !c.is_archived);
  const activeVehicles = (dataOptions?.vehicles || []).filter(v => !v.is_archived);
  const activeZones = (dataOptions?.zones || []).filter(z => !z.is_archived);

  // ✅ CREW PAGINATION STATE (USING ONLY ACTIVE COLLECTORS)
  const [crewPage, setCrewPage] = useState(0);
  const crewPerPage = 6; // 2 rows * 3 columns
  const totalCrewPages = Math.ceil((activeCollectors.length || 0) / crewPerPage);

  const [activeDropdown, setActiveDropdown] = useState(null);
  const dropdownRef = useRef(null);

  const modalVars = {
    hidden: { opacity: 0, scale: 0.98, y: 10 },
    visible: { 
      opacity: 1, scale: 1, y: 0,
      transition: { 
        type: "spring", damping: 25, stiffness: 300, 
        staggerChildren: 0.05, delayChildren: 0.05 
      }
    },
    exit: { opacity: 0, scale: 0.99, transition: { duration: 0.15 } }
  };

  const itemVars = {
    hidden: { opacity: 0, y: 10 },
    visible: { opacity: 1, y: 0, transition: { duration: 0.2, ease: "easeOut" } }
  };

  useEffect(() => {
    if (editingData && isOpen) {
      setFormData({
        ...editingData,
        collector_ids: Array.isArray(editingData.collector_ids) ? editingData.collector_ids : [],
        work_days: Array.isArray(editingData.work_days) ? editingData.work_days : []
      });
    } else if (isOpen) {
      setFormData({ driver_id: '', collector_ids: [], vehicle_id: '', zone_id: '', work_days: [], start_time: '', end_time: '', start_date: '', end_date: '' });
      setCrewPage(0); // Reset page on open
    }
  }, [editingData, isOpen]);

  const toggleDay = (day) => {
    setFormData(prev => ({ 
      ...prev, 
      work_days: prev.work_days.includes(day) ? prev.work_days.filter(d => d !== day) : [...prev.work_days, day] 
    }));
  };

  const handleCollectorToggle = (id) => {
    if (formData.collector_ids.length >= 3 && !formData.collector_ids.includes(id)) return;
    setFormData(prev => ({ 
      ...prev, 
      collector_ids: prev.collector_ids.includes(id) ? prev.collector_ids.filter(cid => cid !== id) : [...prev.collector_ids, id] 
    }));
  };

  const labelStyle = "flex items-center gap-2 text-[10px] font-black text-slate-400 mb-2 uppercase tracking-[0.2em]";
  const inputStyle = "w-full px-5 py-3.5 rounded-2xl border border-slate-200 bg-slate-50/50 outline-none focus:bg-white focus:ring-4 focus:ring-emerald-500/5 focus:border-emerald-500 transition-all duration-150 text-sm font-bold text-slate-700 appearance-none";

  // PAGINATION LOGIC (USING ONLY ACTIVE COLLECTORS)
  const currentCrew = activeCollectors.slice(crewPage * crewPerPage, (crewPage + 1) * crewPerPage) || [];

  return (
    <AnimatePresence>
      {isOpen && (
        <div 
          className="fixed inset-0 z-[6000] flex items-center justify-center p-4 overflow-hidden"
        >
          <motion.div 
            initial={{ opacity: 0 }}
            animate={{ opacity: 1 }}
            exit={{ opacity: 0 }}
            onClick={onClose} 
            className="absolute inset-0 bg-slate-900/60 backdrop-blur-[1px]" 
          />
          
          <motion.div 
            variants={modalVars} 
            initial="hidden" 
            animate="visible" 
            exit="hidden" 
            className="bg-white w-full max-w-4xl rounded-[40px] shadow-2xl relative overflow-hidden flex flex-col max-h-[92vh]"
          >
            {/* HEADER */}
            <div 
              className={`px-10 py-8 border-b border-slate-50 flex justify-between items-center ${editingData ? 'bg-slate-800' : 'bg-green-600'} text-white shrink-0`}
            >
              <div 
                className="flex items-center gap-5"
              >
                <motion.div 
                  initial={{ rotate: -15, scale: 0.5 }} 
                  animate={{ rotate: 0, scale: 1 }} 
                  className="w-12 h-12 bg-white/20 border border-white/20 rounded-2xl flex items-center justify-center backdrop-blur-sm shadow-lg"
                >
                  {editingData ? <Edit3 size={24} /> : <ShieldCheck size={24} />}
                </motion.div>
                <div>
                  <h3 
                    className="font-black text-xl tracking-tight"
                  >
                    {editingData ? 'Update Team' : 'Create Team'}
                  </h3>
                  <p 
                    className="text-white/70 text-[10px] font-bold uppercase tracking-widest"
                  >
                    Resource Allocation Protocol
                  </p>
                </div>
              </div>
              <motion.button 
                whileHover={{ rotate: 90, scale: 1.1 }} 
                whileTap={{ scale: 0.9 }} 
                onClick={onClose} 
                className="p-2 hover:bg-white/10 rounded-xl transition-all"
              >
                <X size={24} />
              </motion.button>
            </div>

            <form 
              onSubmit={(e) => { e.preventDefault(); onCreate(formData); }} 
              className="p-10 overflow-y-auto custom-scrollbar space-y-8"
              ref={dropdownRef}
            >
              {/* Row 1: Fleet & Driver Dropdowns (USING ACTIVE LISTS) */}
              <motion.div 
                variants={itemVars} 
                className="grid grid-cols-1 md:grid-cols-2 gap-8"
              >
                <CustomDropdown 
                  label="Fleet Asset" 
                  icon={Truck} 
                  options={activeVehicles} 
                  value={formData.vehicle_id} 
                  onChange={(v) => setFormData({...formData, vehicle_id: v})} 
                  placeholder="Assign a vehicle" 
                  isUserType={false} 
                />
                <CustomDropdown 
                  label="Lead Driver" 
                  icon={User} 
                  options={activeDrivers} 
                  value={formData.driver_id} 
                  onChange={(v) => setFormData({...formData, driver_id: v})} 
                  placeholder="Assign lead driver" 
                  isUserType={true} 
                />
              </motion.div>

              {/* CREW SELECTION WITH PAGINATION */}
              <motion.div 
                variants={itemVars}
              >
                <div 
                  className="flex justify-between items-center mb-4"
                >
                  <label 
                    className={labelStyle}
                  >
                    <Users size={14} /> Crew Selection (Max 3)
                  </label>
                  <div 
                    className="flex items-center gap-3"
                  >
                    {/* Pagination Controls */}
                    <div 
                      className="flex items-center gap-1 bg-slate-100 p-1 rounded-lg border border-slate-200"
                    >
                      <button 
                        type="button"
                        disabled={crewPage === 0}
                        onClick={() => setCrewPage(prev => prev - 1)}
                        className="p-1 hover:bg-white rounded-md disabled:opacity-30 disabled:cursor-not-allowed transition-all"
                      >
                        <ChevronLeft size={14} />
                      </button>
                      <span 
                        className="text-[9px] font-black px-2 text-slate-500 uppercase"
                      >
                        Page {crewPage + 1} of {totalCrewPages || 1}
                      </span>
                      <button 
                        type="button"
                        disabled={crewPage >= totalCrewPages - 1}
                        onClick={() => setCrewPage(prev => prev + 1)}
                        className="p-1 hover:bg-white rounded-md disabled:opacity-30 disabled:cursor-not-allowed transition-all"
                      >
                        <ChevronRight size={14} />
                      </button>
                    </div>
                    <span 
                      className={`text-[10px] font-black px-2.5 py-1 rounded-full border ${formData.collector_ids.length === 3 ? 'bg-emerald-500 text-white border-emerald-500' : 'bg-slate-100 text-slate-400'}`}
                    >
                      {formData.collector_ids.length} / 3 Selected
                    </span>
                  </div>
                </div>
                
                {/* Crew Grid */}
                <div 
                  className="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-4"
                >
                  <AnimatePresence mode="wait">
                    {currentCrew.map((c) => {
                      const isSelected = formData.collector_ids.includes(c.user_id);
                      return (
                        <motion.div 
                          key={c.user_id}
                          initial={{ opacity: 0, scale: 0.95 }}
                          animate={{ opacity: 1, scale: 1 }}
                          exit={{ opacity: 0, scale: 0.95 }}
                          transition={{ duration: 0.1 }}
                          whileHover={{ y: -2, transition: { duration: 0.1 } }} 
                          whileTap={{ scale: 0.98 }} 
                          onClick={() => handleCollectorToggle(c.user_id)} 
                          className={`p-4 rounded-[24px] border transition-all duration-150 cursor-pointer relative ${isSelected ? 'border-emerald-500 bg-emerald-50 shadow-md' : 'bg-white border-slate-100 hover:border-emerald-300'}`}
                        >
                          <div 
                            className="flex items-center gap-3 overflow-hidden"
                          >
                            <div 
                              className={`w-9 h-9 flex-shrink-0 rounded-xl flex items-center justify-center text-xs font-black transition-colors ${isSelected ? 'bg-emerald-600 text-white' : 'bg-slate-100 text-slate-400'}`}
                            >
                              {c.first_name?.charAt(0)}
                            </div>
                            <div 
                              className="truncate min-w-0"
                            >
                              <p 
                                className="text-sm font-bold text-slate-700 truncate"
                              >
                                {c.first_name} {c.last_name}
                              </p>
                              <p 
                                className={`text-[9px] font-bold uppercase tracking-tighter ${isSelected ? 'text-emerald-500' : 'text-slate-400'}`}
                              >
                                ID: #{c.user_id}
                              </p>
                            </div>
                          </div>
                          {isSelected && (
                            <motion.div 
                              layoutId="check-icon" 
                              className="absolute top-2 right-2 text-emerald-600"
                            >
                              <CheckCircle2 size={14} />
                            </motion.div>
                          )}
                        </motion.div>
                      );
                    })}
                  </AnimatePresence>
                </div>
              </motion.div>

              {/* Row 3: Zone & Days (USING ACTIVE ZONES) */}
              <motion.div 
                variants={itemVars} 
                className="grid grid-cols-1 lg:grid-cols-2 gap-8"
              >
                <CustomDropdown 
                  label="Service Zone" 
                  icon={MapPin} 
                  options={activeZones} 
                  value={formData.zone_id} 
                  onChange={(v) => setFormData({...formData, zone_id: v})} 
                  placeholder="Select area" 
                  isUserType={false} 
                />
                <div>
                  <label 
                    className={labelStyle}
                  >
                    <Calendar size={14} /> Operation Days
                  </label>
                  <div 
                    className="flex flex-wrap gap-2"
                  >
                    {['Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat', 'Sun'].map(day => (
                      <motion.button 
                        key={day} 
                        type="button" 
                        whileHover={{ scale: 1.05, transition: { duration: 0.1 } }} 
                        whileTap={{ scale: 0.95 }} 
                        onClick={() => toggleDay(day)} 
                        className={`flex-1 min-w-[45px] py-3.5 rounded-2xl text-[10px] font-black uppercase transition-all duration-150 ${formData.work_days.includes(day) ? 'bg-slate-800 text-white shadow-lg' : 'bg-slate-50 border border-slate-100 text-slate-400 hover:bg-slate-200'}`}
                      >
                        {day.substring(0, 1)}
                      </motion.button>
                    ))}
                  </div>
                </div>
              </motion.div>

              {/* Row 4: Timeline Sections (OLD DESIGN RESTORED) */}
              <motion.div 
                variants={itemVars} 
                className="grid grid-cols-1 md:grid-cols-2 gap-8"
              >
                <div 
                  className="space-y-6 bg-slate-50/50 p-6 rounded-[30px] border border-slate-100 group focus-within:bg-white focus-within:border-emerald-200 transition-all duration-200"
                >
                  <p 
                    className="text-[10px] font-black text-emerald-600 uppercase tracking-widest mb-4"
                  >
                    Commencement
                  </p>
                  <div>
                    <label 
                      className={labelStyle}
                    >
                      <Clock size={12} /> Start Time
                    </label>
                    <input 
                      type="time" 
                      className={inputStyle} 
                      value={formData.start_time} 
                      onChange={(e) => setFormData({...formData, start_time: e.target.value})} 
                    />
                  </div>
                  <div>
                    <label 
                      className={labelStyle}
                    >
                      <Calendar size={12} /> Start Date
                    </label>
                    <input 
                      type="date" 
                      className={inputStyle} 
                      value={formData.start_date} 
                      onChange={(e) => setFormData({...formData, start_date: e.target.value})} 
                    />
                  </div>
                </div>

                <div 
                  className="space-y-6 bg-slate-50/50 p-6 rounded-[30px] border border-slate-100 group focus-within:bg-white focus-within:border-rose-200 transition-all duration-200"
                >
                  <p 
                    className="text-[10px] font-black text-rose-600 uppercase tracking-widest mb-4"
                  >
                    Termination
                  </p>
                  <div>
                    <label 
                      className={labelStyle}
                    >
                      <Clock size={12} /> End Time
                    </label>
                    <input 
                      type="time" 
                      className={inputStyle} 
                      value={formData.end_time} 
                      onChange={(e) => setFormData({...formData, end_time: e.target.value})} 
                    />
                  </div>
                  <div>
                    <label 
                      className={labelStyle}
                    >
                      <Calendar size={12} /> End Date
                    </label>
                    <input 
                      type="date" 
                      className={inputStyle} 
                      value={formData.end_date} 
                      onChange={(e) => setFormData({...formData, end_date: e.target.value})} 
                    />
                  </div>
                </div>
              </motion.div>

              {/* Form Actions */}
              <motion.div 
                variants={itemVars} 
                className="flex gap-4 pt-6"
              >
                <motion.button 
                  type="button" 
                  whileHover={{ scale: 1.02 }} 
                  onClick={onClose} 
                  className="flex-1 py-4 text-slate-400 font-black uppercase text-[10px] tracking-widest rounded-3xl hover:bg-rose-50 hover:text-rose-500 transition-all duration-150"
                >
                  Discard
                </motion.button>
                <motion.button 
                  type="submit" 
                  whileHover={{ scale: 1.02, y: -2, boxShadow: '0 20px 25px -5px rgb(16 185 129 / 0.2)' }} 
                  whileTap={{ scale: 0.98 }} 
                  className={`flex-[2] py-4 ${editingData ? 'bg-slate-800' : 'bg-emerald-600'} text-white font-black rounded-3xl shadow-xl hover:opacity-90 transition-all text-[10px] uppercase tracking-[0.2em] flex items-center justify-center gap-3`}
                >
                  {editingData ? <Save size={18} /> : <CheckCircle2 size={18} />}
                  {editingData ? 'Save Changes' : 'Create Team'}
                </motion.button>
              </motion.div>
            </form>
          </motion.div>
        </div>
      )}
    </AnimatePresence>
  );
};

export default CreateAssignmentModal;
</file>

<file path="src/components/DutyLogModal.jsx">
import React from 'react';
import { X, ClipboardList, Calendar, Clock, Users, Trash2, CheckCircle2 } from 'lucide-react';

const DutyLogModal = ({ isOpen, onClose, vehicleTitle, scheduleRef, logHistory, movementState }) => {
  if (!isOpen) return null;

  return (
    <div className="fixed inset-0 z-[100] flex items-center justify-center bg-black/60 backdrop-blur-sm p-4 animate-in fade-in duration-300">
      <div className="bg-white rounded-[2rem] shadow-2xl w-full max-w-5xl max-h-[85vh] overflow-hidden flex flex-col animate-in zoom-in-95 duration-300">
        
        {/* Modal Header */}
        <div className="p-8 bg-[#1B5E20] text-white flex justify-between items-center relative overflow-hidden">
          <div className="absolute -right-12 -top-12 w-48 h-48 bg-white/10 rounded-full blur-3xl" />
          <div className="relative z-10">
            <div className="flex items-center gap-3 mb-1">
              <ClipboardList className="text-emerald-300" size={28} />
