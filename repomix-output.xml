    "UPDATE zones SET zone_name = $1, zone_color = $2, boundaries = $3 WHERE zone_id = $4 RETURNING *",
    [zone_name, zone_color, JSON.stringify(boundaries), id]
  );
  return result.rows[0];
};

module.exports = { createZone, getAllZones, updateZone };
