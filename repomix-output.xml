<file path="admin-dashboard/src/pages/Login.jsx">
import React, { useState } from 'react';
import { useNavigate } from 'react-router-dom';
import { authService } from '../services/authService';
import { useUser } from '../context/UserContext'; // ✅ 1. Import useUser
import { ShieldAlert, AlertCircle, Eye, EyeOff } from 'lucide-react'; 

const Login = () => {
  const [email, setEmail] = useState('');
  const [password, setPassword] = useState('');
  const [showPassword, setShowPassword] = useState(false); 
  const [error, setError] = useState({ msg: '', type: '' });
  const navigate = useNavigate();
  const { setUser } = useUser(); // ✅ 2. Destructure setUser

  const handleLogin = async (e) => {
    e.preventDefault();
    setError({ msg: '', type: 'auth' });

    try {
      const response = await authService.login({ email, password, loginType: 'website' });
      const data = await response.json();

      if (response.status === 403) {
        setError({ 
          msg: data || "Access Denied: You do not have permission to access this portal.", 
          type: 'security' 
        });
        return;
      }

      if (response.status === 401) {
        setError({ msg: data || "Invalid email or password.", type: 'auth' });
        return;
      }

      if (response.ok) {
        // ✅ 3. Update the Global State (Crucial!)
        // This tells the whole app WHO is logged in immediately 
        // without waiting for a browser refresh.
        setUser(data.user); 

        // 4. Save to storage for persistence
        localStorage.setItem("token", data.token);
        localStorage.setItem("userProfile", JSON.stringify(data.user));
        
        navigate('/dashboard');
      }
    } catch (err) {
      setError({ msg: "Network error. Please check your server.", type: 'network' });
    }
  };

  return (
    <div className="flex h-screen w-full font-sans overflow-hidden">
      
      {/* LEFT SIDE (Visuals) */}
      <div className="hidden lg:flex w-1/2 bg-[#108e56] flex-col justify-between items-center relative p-8 xl:p-12">
        <div className="absolute -top-16 -left-16 w-64 h-64 border-4 border-white opacity-10 rounded-full pointer-events-none"></div>
        <div className="absolute top-1/4 -right-20 w-96 h-96 bg-white opacity-5 rounded-full pointer-events-none"></div>
        <div className="absolute -bottom-40 -left-16 w-64 h-64 border-4 border-white opacity-10 rounded-full pointer-events-none"></div>
        <div className="absolute top-0 right-1/4 w-24 h-24 border border-white opacity-20 rounded-full pointer-events-none"></div>

        <div className="z-10 w-full max-w-lg flex flex-col items-center h-full justify-center">
          <div>
            <img 
              src="/login-cover-waste.jpg" 
              alt="Waste Management" 
              className="w-full h-auto max-h-[47vh] object-contain rounded-xl mx-auto mt-5"
            />
          </div>
          <div className="text-center mb-8 shrink-0">
            <h1 className="text-3xl xl:text-4xl font-bold text-white mb-4 drop-shadow-md">
              Waste Management <br /> Reporting System
            </h1>
            <p className="text-green-50 text-base xl:text-lg leading-relaxed">
              Monitor, track, and optimize your waste collection operations in real-time.
            </p>
          </div>
          
          <div className="w-full grid grid-cols-2 gap-4 mt-auto">
            <div className="h-15 xl:h-20 bg-white/10 rounded-3xl w-full backdrop-blur-sm border border-white/10"></div>
            <div className="h-15 xl:h-20 bg-white/10 rounded-3xl w-full backdrop-blur-sm border border-white/10"></div>
            <div className="h-15 xl:h-20 bg-white/10 rounded-3xl w-full backdrop-blur-sm border border-white/10"></div>
            <div className="h-15 xl:h-20 bg-white/10 rounded-3xl w-full backdrop-blur-sm border border-white/10"></div>
          </div>
        </div>
      </div>

      {/* RIGHT SIDE: Login Form */}
      <div className="w-full lg:w-1/2 flex items-center justify-center bg-[#f0fdf4] p-6 lg:p-12 h-full overflow-y-auto">
        <div className="w-full max-w-md">
          
          <div className="text-center mb-8">
            <img src="/Logo.png" alt="Logo" className="w-35 h-35 mx-auto mb-4" />
            <h2 className="text-2xl lg:text-3xl font-bold text-gray-800">Welcome Back</h2>
            <p className="text-gray-500 mt-2 text-sm lg:text-base">Sign in to your Administrator Dashboard</p>
          </div>

          {error.msg && (
            <div className={`flex items-start gap-3 px-4 py-3 rounded-xl border mb-6 animate-bounce-short ${
              error.type === 'security' 
                ? 'bg-amber-50 border-amber-200 text-amber-800' 
                : 'bg-red-50 border-red-200 text-red-700'
            }`}>
              {error.type === 'security' ? <ShieldAlert className="shrink-0 mt-0.5" size={18} /> : <AlertCircle className="shrink-0 mt-0.5" size={18} />}
              <div className="text-sm font-medium">
                <strong className="block">{error.type === 'security' ? 'Security Alert' : 'Login Error'}</strong>
                {error.msg}
              </div>
            </div>
          )}

          <form onSubmit={handleLogin} className="space-y-5">
            <div>
              <label className="block text-sm font-semibold text-gray-700 mb-1">Email Address</label>
              <input
                type="email"
                required
                className="w-full px-4 py-3 rounded-lg bg-gray-100 border border-gray-200 focus:border-[#108e56] focus:bg-white focus:ring-2 focus:ring-green-100 outline-none transition-all"
                placeholder="admin@email.com"
                value={email}
                onChange={(e) => setEmail(e.target.value)}
              />
            </div>
            
            <div>
              <label className="block text-sm font-semibold text-gray-700 mb-1">Password</label>
              <div className="relative">
                <input
                  type={showPassword ? "text" : "password"}
                  required
                  className="w-full px-4 py-3 rounded-lg bg-gray-100 border border-gray-200 focus:border-[#108e56] focus:bg-white focus:ring-2 focus:ring-green-100 outline-none transition-all pr-12"
                  placeholder="••••••••"
                  value={password}
                  onChange={(e) => setPassword(e.target.value)}
                />
                <button
                  type="button"
                  onClick={() => setShowPassword(!showPassword)}
                  className="absolute right-3 top-1/2 -translate-y-1/2 text-gray-400 hover:text-gray-600 transition-colors p-1"
                >
                  {showPassword ? <EyeOff size={20} /> : <Eye size={20} />}
                </button>
              </div>
            </div>

            <div className="flex items-center justify-between text-sm">
              <label className="flex items-center text-gray-600 cursor-pointer select-none">
                <input type="checkbox" className="mr-2 w-4 h-4 text-[#108e56] rounded border-gray-300 focus:ring-[#108e56]" />
                Remember me
              </label>
              <a href="#" className="text-[#108e56] font-semibold hover:underline">Forgot Password?</a>
            </div>

            <button
              type="submit"
              className="w-full bg-[#047857] hover:bg-[#065f46] text-white font-bold py-3 rounded-lg shadow-md hover:shadow-lg transition-all transform hover:-translate-y-0.5"
            >
              Sign In
            </button>
          </form>

          <div className="mt-8 pt-6 border-t border-gray-200 text-center">
            <p className="text-xs text-gray-400 uppercase tracking-wide">
              Secure access for authorized personnel only
            </p>
          </div>
          
        </div>
      </div>
    </div>
  );
};

export default Login;
</file>

<file path="admin-dashboard/src/pages/ProfileSettings.jsx">
import React, { useState, useEffect } from 'react';
import { useNavigate } from 'react-router-dom';
import { 
  User, MapPin, Calendar, Camera, Save, 
  Mail, Phone, Shield, Bell, Search, Info
} from 'lucide-react'; 
import { design } from '../styles/design'; 
import { authService } from '../services/authService';
import { userService } from '../services/userService';
import Notification from '../components/Notification';
import { useUser } from '../context/UserContext';

const ProfileSettings = () => {
  const navigate = useNavigate();
  const { user, setUser } = useUser();
  const [adminUser, setAdminUser] = useState(null);
  const [formData, setFormData] = useState({
    gender: '',
    birthday: '',
    address: ''
  });
  const [notify, setNotify] = useState({ show: false, msg: '', type: 'success' });

  const { layout: l, userManagement: u } = design;

  // Helper to format date safely without timezone shifting
  // ✅ Helper to format date safely without timezone shifting
const formatDateForInput = (dateString) => {
  if (!dateString) return '';
  // This creates a date object and extracts only the YYYY-MM-DD part based on local date
  const date = new Date(dateString);
  const year = date.getFullYear();
  const month = String(date.getMonth() + 1).padStart(2, '0');
  const day = String(date.getDate()).padStart(2, '0');
  return `${year}-${month}-${day}`;
};

useEffect(() => {
  const init = async () => {
    const userData = await authService.verifyToken();
    if (!userData) { navigate("/login"); return; }
    
    setAdminUser(userData);
    setUser(userData); 
    
    setFormData({
      gender: userData.gender || '',
      // ✅ Use the safe formatter here
      birthday: formatDateForInput(userData.birthday),
      address: userData.address || ''
    });
  };
  init();
}, [navigate, setUser]);

const handleUpdate = async (e) => {
  e.preventDefault();
  try {
    // 1. Get the most current data from state
    const updatePayload = {
      ...adminUser,      // Spread existing user (ID, current pic, etc.)
      ...formData,       // Spread the editable fields (gender, birthday, address)
      // Ensure these are explicitly mapped to backend names
      first_name: adminUser.first_name,
      last_name: adminUser.last_name,
      contact_number: adminUser.contact_number
    };

    const result = await userService.updateUser(adminUser.user_id, updatePayload);

    if (result) {
      // 2. Update the Context and Local Storage immediately
      setUser(result); 
      setAdminUser(result);
      localStorage.setItem("userProfile", JSON.stringify(result));
      
      setNotify({ show: true, msg: "Profile synced across roles!", type: 'success' });
    }
  } catch (err) {
    setNotify({ show: true, msg: "Save failed", type: 'error' });
  }
};

const handlePhotoChange = async (e) => {
    const file = e.target.files[0];
    if (!file) return;

    // Optional: Check file size (e.g., limit to 2MB)
    if (file.size > 2 * 1024 * 1024) {
        setNotify({ show: true, msg: "File too large (Max 2MB)", type: 'error' });
        return;
    }

    const uploadData = new FormData();
    uploadData.append('profile_image', file); // This key MUST match upload.single('profile_image')

    try {
        const res = await userService.uploadAvatar(uploadData);
        if (res.profile_picture) {
            setNotify({ show: true, msg: "Photo updated successfully!", type: 'success' });
            
            // Refresh local state
            const userData = await authService.verifyToken();
            if (userData) {
                setAdminUser(userData);
                setUser(userData);
                localStorage.setItem("userProfile", JSON.stringify(userData));
            }
        }
    } catch (err) {
        console.error("Upload Error:", err);
        setNotify({ show: true, msg: err.message || "Upload failed", type: 'error' });
    }
};

  return (
    <div className="h-full bg-[#f0fdf4] overflow-y-auto relative font-sans">
      <header className={l.header}>
        <div className="relative w-full max-w-2xl"> 
          <Search className="absolute left-3 top-2.5 text-gray-500" size={18} />
          <input type="text" placeholder="Profile settings" className={l.searchBox} disabled />
        </div>

        <div className="flex items-center gap-6">
          <button className="relative text-gray-600 hover:text-green-700"><Bell size={24} /></button>
          <div className="flex items-center gap-3 pl-6 border-l border-gray-300">
            <div className="text-right hidden md:block">
              <p className="text-sm font-bold text-gray-800 leading-tight">
                {adminUser?.first_name} {adminUser?.last_name}
              </p>
              <p className="text-[10px] font-bold text-green-600 uppercase tracking-wider">{adminUser?.role}</p>
            </div>
            <div className={l.profileCircle}>
              {adminUser?.profile_picture ? (
                <img src={`http://localhost:5000${adminUser.profile_picture}`} alt="Admin" className="w-full h-full object-cover" />
              ) : (
                <img src={`https://api.dicebear.com/7.x/avataaars/svg?seed=${adminUser?.first_name || 'Admin'}`} alt="Admin" />
              )}
            </div>
          </div>
        </div>
      </header>

      <main className="p-8">
        <div className={u.titleSection} >
          <h2 className="text-2xl font-bold text-[#1B5E20]">Account Settings</h2>
          <p className="text-gray-600 text-sm mt-1">Manage your personal information and profile</p>
        </div>

        <div className="grid grid-cols-1 lg:grid-cols-3 gap-8 mt-8 pb-10">
          <div className="space-y-6">
            <div className="bg-white p-8 rounded-2xl shadow-sm border border-gray-100 flex flex-col items-center" style={{ borderTop: '5px solid #2B9447' }}>
              <div className="relative group">
                <div className="w-32 h-32 rounded-full overflow-hidden border-4 border-green-50 shadow-sm bg-gray-50">
                  {adminUser?.profile_picture ? (
                    <img src={`http://localhost:5000${adminUser.profile_picture}`} alt="Avatar" className="w-full h-full object-cover" />
                  ) : (
                    <img src={`https://api.dicebear.com/7.x/avataaars/svg?seed=${adminUser?.first_name}`} alt="Avatar" />
                  )}
                </div>
                <label className="absolute bottom-0 right-0 bg-[#4CAF50] text-white p-2.5 rounded-full cursor-pointer shadow-lg hover:bg-[#43A047] transition-all hover:scale-110">
